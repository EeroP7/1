# Copy to .env and fill in your values

# Polymarket CLOB credentials (from app.polymarket.com → Profile → API)
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# BTC UP/DOWN 5MIN market condition IDs
# Find at: https://clob.polymarket.com/markets?search=BTC
MARKET_CONDITION_UP=
MARKET_CONDITION_DOWN=

# CryptoQuant (optional — falls back to synthetic flow signals without this)
CRYPTOQUANT_API_KEY=

# Safety: set to "false" to go live
DRY_RUN=true
