# Alpaca paper trading credentials (paper only — live requires per-order approval)
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: alert webhook (Slack / Discord)
ALERT_WEBHOOK_URL=

# Ranking / execution settings (override defaults)
TOP_N=10
MIN_PRICE=5.0
MIN_ADV=1000000
REBALANCE_FREQ=weekly
MAX_WEIGHT=0.15
SECTOR_CAP=0.30
DSR_THRESHOLD=0.95
