# Copy to .env and fill in your credentials

# Polymarket CLOB API (from https://polymarket.com → Profile → API Keys)
POLY_PRIVATE_KEY=0x_your_polygon_wallet_private_key
POLY_API_KEY=your_api_key
POLY_API_SECRET=your_api_secret
POLY_PASSPHRASE=your_passphrase
POLY_CHAIN_ID=137

# Starting balance for risk calculations (in USD)
STARTING_BALANCE=1000

# MiroFish swarm intelligence (github.com/666ghj/MiroFish)
# Start MiroFish with: npm run dev  (inside the cloned MiroFish repo)
MIROFISH_ENABLED=true
MIROFISH_HOST=http://localhost:5001
MIROFISH_REFRESH_MIN=15        # re-run swarm simulation every N minutes
LLM_API_KEY=your_openai_or_qwen_key  # same key used in MiroFish .env
