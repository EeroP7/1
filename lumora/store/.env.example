# Copy to .env.local and fill in to go live.

# Your public site URL (used for SEO + Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=https://lumora.co

# Stripe — get keys at https://dashboard.stripe.com/apikeys
# Leave blank to run the store in demo mode (no live payments).
STRIPE_SECRET_KEY=

# Optional: email service provider for delivering downloads + the welcome flow.
# (Klaviyo / ConvertKit / Beehiiv / Resend) — wire into /api/checkout success.
ESP_API_KEY=
